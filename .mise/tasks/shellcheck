#!/usr/bin/env bash
#MISE description="Check Bash scripts with ShellCheck (use --env dev)"
set -euo pipefail
scripts=()
while IFS= read -r -d '' script; do
  scripts+=("$script")
done < <(find .mise/tasks scripts/test-community -type f ! -name '*.md' -print0)
shellcheck --shell=bash "${scripts[@]}"
